<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dataGrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
             x:Class="StandardApiFrameworkTool.Views.ReceiveDataView">
    <Grid Margin="20">
        <TabControl>
            <TabItem Header="Encryption">
                <Grid RowDefinitions="Auto,5*,5*">
                    <TextBlock Text="Manage Private Keys" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" Grid.Row="0" />

                    <dataGrid:DataGrid Grid.Row="1" ItemsSource="{Binding PrivateKeys}"
                                       AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       Margin="0,10,0,10">
                        <dataGrid:DataGrid.Columns>
                            <dataGrid:DataGridTextColumn Header="Key ID" Binding="{Binding Id}" Width="*" />
                            <dataGrid:DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                            <dataGrid:DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat=d}" Width="*" />
                            <dataGrid:DataGridTemplateColumn Header="Active" Width="Auto">
                                <dataGrid:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <shapes:Ellipse Width="15"
                                                        Height="15"
                                                        Fill="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}" />
                                    </DataTemplate>
                                </dataGrid:DataGridTemplateColumn.CellTemplate>
                            </dataGrid:DataGridTemplateColumn>
                            <dataGrid:DataGridTemplateColumn Header="Activate" Width="Auto">
                                <dataGrid:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Activate"
                                                Padding="6,2"
                                                Command="{Binding DataContext.ActivateEncPublicKeyCommand, RelativeSource={RelativeSource AncestorType=dataGrid:DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </dataGrid:DataGridTemplateColumn.CellTemplate>
                            </dataGrid:DataGridTemplateColumn>
                        </dataGrid:DataGrid.Columns>
                    </dataGrid:DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0" RowDefinitions="Auto,8*,2*" ColumnDefinitions="*,*">
                        <TextBlock Text="Generated Key Pair:" FontWeight="SemiBold" FontSize="13" Grid.Row="0" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Margin="0,5,0,10"
                                 Text="{Binding GeneratedPublicKey}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Margin="0,5,0,10"
                                 Text="{Binding GeneratedPrivateKey}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left">
                            <Button Content="Create Key Pair"
                                    Margin="0,0,10,0"
                                    Command="{Binding GenerateKeyPairCommand}" />
                            <Button Content="Validate &amp; Upload Key"
                                    Grid.Column="1"
                                    Command="{Binding UploadEncKeyCommand}" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Signature">
                <Grid RowDefinitions="Auto,5*,5*">
                    <TextBlock Text="Manage Private Keys (Signature)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" Grid.Row="0" />

                    <dataGrid:DataGrid Grid.Row="1" ItemsSource="{Binding SignatureKeys}"
                                       AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       Margin="0,10,0,10">
                        <dataGrid:DataGrid.Columns>
                            <dataGrid:DataGridTextColumn Header="Key ID" Binding="{Binding Id}" Width="*" />
                            <dataGrid:DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                            <dataGrid:DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat=d}" Width="*" />
                            <dataGrid:DataGridTemplateColumn Header="Active" Width="Auto">
                                <dataGrid:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <shapes:Ellipse Width="15"
                                                        Height="15"
                                                        Fill="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}" />
                                    </DataTemplate>
                                </dataGrid:DataGridTemplateColumn.CellTemplate>
                            </dataGrid:DataGridTemplateColumn>
                            <dataGrid:DataGridTemplateColumn Header="Activate" Width="Auto">
                                <dataGrid:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Activate"
                                                Padding="6,2"
                                                Command="{Binding DataContext.ActivateSignPublicKeyCommand, RelativeSource={RelativeSource AncestorType=dataGrid:DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </dataGrid:DataGridTemplateColumn.CellTemplate>
                            </dataGrid:DataGridTemplateColumn>
                        </dataGrid:DataGrid.Columns>
                    </dataGrid:DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0" RowDefinitions="Auto,8*,2*" ColumnDefinitions="*,*">
                        <TextBlock Text="Generated Key Pair:" FontWeight="SemiBold" FontSize="13" Grid.Row="0" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Margin="0,5,0,10"
                                 Text="{Binding GeneratedSignaturePublicKey}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Margin="0,5,0,10"
                                 Text="{Binding GeneratedSignaturePrivateKey}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left">
                            <Button Content="Create Key Pair"
                                    Margin="0,0,10,0"
                                    Command="{Binding GenerateSignatureKeyPairCommand}" />
                            <Button Content="Validate &amp; Upload Key"
                                    Grid.Column="1"
                                    Command="{Binding UploadSignatureKeyCommand}" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Received Events">
                <Grid RowDefinitions="*,Auto" ColumnDefinitions="2.5*,7.5*">
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0" Grid.Column="0" Grid.Row="0">
                        <ListBox ItemsSource="{Binding ThreadList}"
                                 SelectedItem="{Binding SelectedThread}"
                                 Margin="5"
                                 Background="WhiteSmoke">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="5,5,0,0" />
                                            <TextBlock Text="{Binding Timestamp}" FontSize="12" Foreground="Gray" Margin="5,0,0,5" />
                                            <TextBlock Text="{Binding Verified}" FontSize="12" FontWeight="Bold" Foreground="Blue" Margin="5,0,0,5" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="4,1"
                                                CornerRadius="5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="15,0,0,0"
                                                Background="{Binding LabelColor}">
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,*">
                        <TextBlock Text="Event Payload"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,0,0,10"
                                   Grid.Row="0" />

                        <TextBox Grid.Row="1"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Margin="0,5,0,0"
                                 Text="{Binding SelectedThreadPayload}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding TopicsInfo}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
