<Window x:Class="StandardApiFrameworkTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Standard Api Framework" Height="800" Width="1200">
    <Grid>
        <!-- Define Rows for the layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Main Content -->
            <RowDefinition Height="Auto" />
            <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <TabControl Grid.Row="0">
            <!-- Home Tab -->
            <TabItem Header="Home">
                <ContentControl Content="{Binding CurrentHomeView}" />
            </TabItem>

            <!-- General Settings Tab -->
            <TabItem Header="General Settings">
                <ContentControl Content="{Binding CurrentGeneralSettingsView}"/>
            </TabItem>

            <!-- Send Data Tab -->
            <TabItem Header="Send Data">
                <ContentControl Content="{Binding CurrentSendDataView}" />
            </TabItem>

            <!-- Receive Data Tab -->
            <TabItem Header="Receive Data">
                <ContentControl Content="{Binding CurrentReceiveDataView}" />
            </TabItem>
        </TabControl>

        <!-- StatusBar at the bottom -->
        <StatusBar Grid.Row="1" Background="{DynamicResource PrimaryHueMidBrush}">
            <TextBlock Text="Ready" 
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       Margin="5" />
            <Separator />
            <TextBlock Text="Last Update: N/A" 
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       Margin="5" />
            <Separator />
            <ProgressBar Width="150" Height="16" 
                         IsIndeterminate="{Binding IsProcessing}"
                          />
            <Separator />
            <TextBlock Text="Version 1" 
               Foreground="White" 
               VerticalAlignment="Center" 
               Margin="5" />
        </StatusBar>
    </Grid>
</Window>
