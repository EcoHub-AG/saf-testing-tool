<UserControl x:Class="StandardApiFrameworkTool.Views.SendDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:local="clr-namespace:StandardApiFrameworkTool.Helpers"
             xmlns:controls="https://spiegelp.github.io/MaterialDesignExtensions/winfx/xaml">
    <Grid Margin="20" >
        <controls:Stepper IsLinear="False" Layout="Horizontal" FontSize="15">
            <controls:Step>
                <controls:Step.Header>
                    <controls:StepTitleHeader FirstLevelTitle="Select receiving membership" SecondLevelTitle="Fetch active public key of member" />
                </controls:Step.Header>
                <controls:Step.Content>
                    <Grid>
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,10,0,0">Select Membership</TextBlock>
                                <ComboBox Width="300" Margin="20,0,0,0"
          ItemsSource="{Binding Receivers}" 
          SelectedItem="{Binding SelectedReceiver}" 
                                          DisplayMemberPath="CompanyName"
          IsEditable="False" />
                                <Button Content="Load Receivers" 
        Command="{Binding LoadReceiversCommand}" 
        Margin="20,10,0,0" HorizontalAlignment="Left" />

                            </StackPanel>
                            <Grid>
                                <controls:StepButtonBar Back="BACK" Continue="CONTINUE" Mode="Horizontal"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </controls:Step.Content>
            </controls:Step>
            <controls:Step>
                <controls:Step.Header>
                    <controls:StepTitleHeader FirstLevelTitle="Zip &amp; Encrypt" />
                </controls:Step.Header>
                <controls:Step.Content>
                    <Grid>
                        <!-- Define responsive rows -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- Write Content Label -->
                            <RowDefinition Height="*" MinHeight="100"/>
                            <!-- Input Editor -->
                            <RowDefinition Height="Auto" />
                            <!-- Encrypted AES Key Label -->
                            <RowDefinition Height="Auto" />
                            <!-- Encrypted AES Key Text -->
                            <RowDefinition Height="Auto" />
                            <!-- Encrypted Content Label -->
                            <RowDefinition Height="Auto" />
                            <!-- Encrypted Content Editor -->
                            <RowDefinition Height="Auto" />
                            <!-- Zip & Encrypt Button -->
                            <RowDefinition Height="Auto" />
                            <!-- Step Button Bar -->
                        </Grid.RowDefinitions>

                        <!-- Write Content Label -->
                        <TextBlock Text="Write Content:" 
                       FontWeight="SemiBold" 
                       Grid.Row="0" />

                        <!-- Input Editor -->
                        <avalonedit:TextEditor 
                Name="InputEditor"
                FontFamily="Consolas"
                FontSize="14"
                ShowLineNumbers="True"
                Loaded="InputEditor_Loaded"
                local:TextEditorHelper.BoundText="{Binding InputContent, UpdateSourceTrigger=PropertyChanged}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                Grid.Row="1" />

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"></ColumnDefinition>
                                <ColumnDefinition Width="0.5*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            
                            <!--#region Encryption Key-->
                            <!-- Encrypted AES Key Label -->
                            <TextBlock Text="Encrypted AES Key:" 
                               FontWeight="SemiBold" 
                               Grid.Row="0" />

                            <!-- Encrypted AES Key Text -->
                            <avalonedit:TextEditor Name="EncryptedAESKeyEditor"
                                   FontSize="14" 
                                   Margin="0,5,0,10" 
                                   FontFamily="Consolas"
                                IsReadOnly="True"
                                ShowLineNumbers="True"
                                Loaded="EncryptedAESKeyEditor_Loaded"
                                local:TextEditorHelper.BoundText="{Binding EncryptedAESKey, UpdateSourceTrigger=PropertyChanged}" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch"
                                   Grid.Row="1" />

                            <!-- Encrypted Content Label -->
                            <TextBlock Text="Encrypted Content:" 
                                FontWeight="SemiBold" 
                                Grid.Row="2" />

                            <!-- Encrypted Content Editor -->
                            <avalonedit:TextEditor Name="EncryptedContentEditor"
                                FontFamily="Consolas"
                                FontSize="14"
                                IsReadOnly="True"
                                ShowLineNumbers="True"
                                Loaded="EncryptedContentEditor_Loaded"
                                Margin="0,5,0,10"
                                local:TextEditorHelper.BoundText="{Binding EncryptedContent, UpdateSourceTrigger=PropertyChanged}" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch"
                                Grid.Row="3" />
                            <!--#endregion-->
                            
                            <!--#region Signature Key-->
                            <!-- Signature Key Label -->
                            <TextBlock Text="Message Hash:" 
                                FontWeight="SemiBold" 
                                Grid.Row="0" Grid.Column="1"/>

                            <!-- Message Hash Text -->
                            <avalonedit:TextEditor Name="MessageHashEditor"
                                   FontSize="14" 
                                   Margin="0,5,0,10" 
                                   FontFamily="Consolas"
                                IsReadOnly="True"
                                ShowLineNumbers="True"
                                Loaded="MessageHashEditor_Loaded"
                                local:TextEditorHelper.BoundText="{Binding MessageHash, UpdateSourceTrigger=PropertyChanged}" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch"
                                   Grid.Row="1" Grid.Column="1" />

                            <!-- Signature Label -->
                            <TextBlock Text="Signature:" 
                                FontWeight="SemiBold" 
                                Grid.Row="2" Grid.Column="1" />

                            <!-- Signature Content Editor -->
                            <avalonedit:TextEditor Name="SignatureContentEditor"
                                FontFamily="Consolas"
                                FontSize="14"
                                IsReadOnly="True"
                                ShowLineNumbers="True"
                                Loaded="SignatureContentEditor_Loaded"
                                Margin="0,5,0,10"
                                local:TextEditorHelper.BoundText="{Binding SignatureContent, UpdateSourceTrigger=PropertyChanged}" 
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch"
                                Grid.Row="3" Grid.Column="1"/>
                            
                            <!--#endregion-->

                        </Grid>
                        

                        <!-- Zip & Encrypt Button -->
                        <Button Content="Zip &amp; Encrypt"
                    Command="{Binding EncryptContentCommand}"
                    HorizontalAlignment="Left"
                    Grid.Row="6" />

                        <!-- Step Button Bar -->
                        <Grid Grid.Row="7">
                            <controls:StepButtonBar Back="BACK" Continue="CONTINUE" Mode="Horizontal"/>
                        </Grid>
                    </Grid>
                </controls:Step.Content>
            </controls:Step>

            <controls:Step>
                <controls:Step.Header>
                    <controls:StepTitleHeader FirstLevelTitle="Create Payload &amp; Send"/>
                </controls:Step.Header>
                <controls:Step.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding GeneratePayloadCommand}">Generate payload</Button>
                        </StackPanel>
                        
                        <avalonedit:TextEditor 
                        Name="Payload"
                        FontFamily="Consolas"
                        FontSize="14"
                        ShowLineNumbers="True"
                        Loaded="Payload_Loaded"
                        Margin="0,5,0,10"
                        local:TextEditorHelper.BoundText="{Binding PayloadContent, UpdateSourceTrigger=PropertyChanged}" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"
                        Grid.Row="1" />

                        <!-- Step Button Bar -->
                        <Grid Grid.Row="2">
                            <!--<controls:StepButtonBar Back="BACK" Continue="SEND" ContinueCommand="{Binding SendPayloadCommand}" Mode="Horizontal"/>-->
                            <Button Command="{Binding SendPayloadCommand}">Send Payload</Button>
                        </Grid>
                    </Grid>
                </controls:Step.Content>
            </controls:Step>
        </controls:Stepper>
    </Grid>
</UserControl>
