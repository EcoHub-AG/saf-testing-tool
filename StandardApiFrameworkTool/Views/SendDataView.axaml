<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StandardApiFrameworkTool.Views.SendDataView">
    <Grid Margin="20" RowDefinitions="Auto,*">
        <TabStrip x:Name="SendTabs"
                  HorizontalAlignment="Center"
                  Grid.Row="0"
                  Margin="0,10,0,10">
            <TabItem Header="Select Receiver">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Margin="0,10,0,0">Select Membership</TextBlock>
                        <ComboBox Width="300"
                                  ItemsSource="{Binding Receivers}"
                                  SelectedItem="{Binding SelectedReceiver}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CompanyName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Load Receivers"
                                Command="{Binding LoadReceiversCommand}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Zip &amp; Encrypt">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                        <TextBlock Margin="0,6,0,0">Process</TextBlock>
                        <ComboBox Width="200"
                                  ItemsSource="{Binding Standards}"
                                  SelectedItem="{Binding SelectedStandard}" />
                        <TextBlock Margin="10,6,0,0">Version</TextBlock>
                        <ComboBox Width="140"
                                  ItemsSource="{Binding Versions}"
                                  SelectedItem="{Binding SelectedVersion}" />
                    </StackPanel>

                    <TextBlock Text="Write Content:"
                               FontWeight="SemiBold"
                               Grid.Row="1" />

                    <TextBox
                        FontFamily="Consolas"
                        FontSize="14"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Text="{Binding InputContent}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Grid.Row="2" />

                    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,16,*">
                        <TextBlock Text="Encrypted AES Key:" FontWeight="SemiBold" Grid.Row="0" />
                        <TextBox
                            FontFamily="Consolas"
                            FontSize="14"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            Text="{Binding EncryptedAESKey}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Grid.Row="1" />

                        <TextBlock Text="Encrypted Content:" FontWeight="SemiBold" Grid.Row="2" />
                        <TextBox
                            FontFamily="Consolas"
                            MaxHeight="100"
                            FontSize="14"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            Text="{Binding EncryptedContent}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Grid.Row="3" />

                        <TextBlock Text="Message Hash:" FontWeight="SemiBold" Grid.Row="0" Grid.Column="2" />
                        <TextBox
                            FontFamily="Consolas"
                            FontSize="14"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            Text="{Binding MessageHash}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Grid.Row="1"
                            Grid.Column="2" />

                        <TextBlock Text="Signature:" FontWeight="SemiBold" Grid.Row="2" Grid.Column="2" />
                        <TextBox
                            FontFamily="Consolas"
                            MaxHeight="100"
                            FontSize="14"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            Text="{Binding SignatureContent}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Grid.Row="3"
                            Grid.Column="2" />
                    </Grid>

                    <Button Content="Zip &amp; Encrypt"
                            Command="{Binding EncryptContentCommand}"
                            HorizontalAlignment="Left"
                            Grid.Row="4"
                            Margin="0,10,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="Create Payload &amp; Send">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Margin="0,6,0,0">Process</TextBlock>
                            <ComboBox Width="200"
                                      ItemsSource="{Binding Standards}"
                                      SelectedItem="{Binding SelectedStandard}" />
                            <TextBlock Margin="10,6,0,0">Version</TextBlock>
                            <ComboBox Width="140"
                                      ItemsSource="{Binding Versions}"
                                      SelectedItem="{Binding SelectedVersion}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding GeneratePayloadCommand}">Generate payload</Button>
                        </StackPanel>
                    </StackPanel>

                    <TextBox
                        FontFamily="Consolas"
                        FontSize="14"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Text="{Binding PayloadContent}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Grid.Row="1"
                        Margin="0,5,0,10" />

                    <Button Command="{Binding SendPayloadCommand}" Grid.Row="2">Send Payload</Button>
                </Grid>
            </TabItem>
        </TabStrip>

        <ContentPresenter Grid.Row="1"
                          Margin="0,10,0,0"
                          Content="{Binding SelectedItem.Content, ElementName=SendTabs}" />
    </Grid>
</UserControl>
