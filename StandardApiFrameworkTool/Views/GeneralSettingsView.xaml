<UserControl x:Class="StandardApiFrameworkTool.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <!-- Left Spacer -->
            <ColumnDefinition Width="Auto" />
            <!-- Middle Content -->
            <ColumnDefinition Width="1*" />
            <!-- Right Spacer -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Title Row -->
            <RowDefinition Height="*" />
            <!-- Content Row -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="General Settings" FontSize="28" FontWeight="Light" 
                   Grid.Row="0" Grid.Column="1" Margin="0,0,0,20" HorizontalAlignment="Center" />

        <!-- Form Content -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition  Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Environment Selector -->
            <TextBlock Text="Select Environment:" FontSize="16" FontWeight="SemiBold" Grid.Row="0" Margin="0,10,0,5" />
            <ComboBox Grid.Row="0" Width="300" FontSize="16" Grid.Column="1" Margin="10,5,0,10"
                      ItemsSource="{Binding Environments}" 
                      SelectedValue="{Binding SelectedEnvironment}" 
                      Style="{StaticResource MaterialDesignComboBox}" />

            <!-- CSM URL -->
            <TextBlock Text="CSM URL:" FontSize="16" FontWeight="SemiBold" Grid.Row="1" Margin="0,10,0,5" />
            <TextBlock Text="{Binding CsmUrl}" FontSize="16" Grid.Row="1" Grid.Column="1" Margin="10,5,0,10" />

            <!-- Services API URL -->
            <TextBlock Text="Services API URL:" FontSize="16" FontWeight="SemiBold" Grid.Row="2" Margin="0,10,0,5" />
            <TextBlock Text="{Binding ServicesApiUrl}" FontSize="16" Grid.Row="2" Grid.Column="1" Margin="10,5,0,10" />

            <!-- IDP Number -->
            <TextBlock Text="IDP Number:" FontSize="16" FontWeight="SemiBold" Grid.Row="3" Margin="0,10,0,5" />
            <TextBox Text="{Binding IdpNumber}" FontSize="16" Width="300" Grid.Row="3" Grid.Column="1" Margin="10,5,0,10" />

            <!-- License Key -->
            <TextBlock Text="License Key:" FontSize="16" FontWeight="SemiBold" Grid.Row="4" Margin="0,10,0,5" />
            <TextBox Text="{Binding LicenseKey}" FontSize="16" Width="300" Grid.Row="4" Grid.Column="1" Margin="10,5,0,10" />

            <!-- Password -->
            <TextBlock Text="Password:" FontSize="16" FontWeight="SemiBold" Grid.Row="5" Margin="0,10,0,5" />
            <TextBox Text="{Binding Password}" FontSize="16" Width="300" Grid.Row="5" Grid.Column="1" Margin="10,5,0,10" />

            <!-- IAK -->
            <TextBlock Text="IAK:" FontSize="16" FontWeight="SemiBold" Grid.Row="6" Margin="0,10,0,5" />
            <TextBox Text="{Binding Iak}" FontSize="16" Width="300" Grid.Row="6" Grid.Column="1" Margin="10,5,0,10" />

            <!-- Out Topic -->
            <TextBlock Text="Org Id:" FontSize="16" FontWeight="SemiBold" Grid.Row="7" Margin="0,10,0,5" />
            <TextBox Text="{Binding OrgId}" FontSize="16" Width="300" Grid.Row="7" Grid.Column="1" Margin="10,5,0,10" />

            <!-- Save Button -->
            <Button Content="Save Settings" Command="{Binding SaveCommand}" 
                    Grid.Row="16" HorizontalAlignment="Left" Padding="10,5" 
                    FontWeight="SemiBold"
                    Margin="0,20,0,0" FontSize="16" Style="{StaticResource MaterialDesignRaisedButton}" />
        </Grid>
    </Grid>
</UserControl>
